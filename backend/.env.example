SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

BACKEND_URL=http://localhost:3000
PORT=3000

# Alamat frontend yang boleh memanggil API ini dari browser.
# Pisahkan dengan koma kalau lebih dari satu.
FRONTEND_URLS=http://localhost:5173,http://192.168.100.56:5173

# Isi hanya kalau backend berjalan di belakang proxy (Railway, Render/Nginx).
# Angkanya = jumlah proxy di depan aplikasi. Kosongkan saat jalan lokal.
TRUST_PROXY=

# Integrasi LLM OpenRouter untuk Peta Belajar (Roadmap AI)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000

